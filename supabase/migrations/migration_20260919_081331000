-- INNOWISE resume verification (post-ATS credibility stage)
-- Extracts professional claims from a resume and checks them against
-- public evidence sources (GitHub public API, LinkedIn self-report).
-- Opt-in for the candidate, consent-first, never auto-rejects.

create table if not exists public.resume_verifications (
  id uuid primary key default gen_random_uuid(),
  application_id uuid not null references public.applications(id) on delete cascade,
  candidate_id uuid not null references public.candidates(id) on delete cascade,
  job_id uuid not null references public.jobs(id) on delete cascade,
  status text not null default 'consent_needed'
    check (status in ('consent_needed','consent_given','analyzing','ready','declined')),
  opted_in boolean not null default false,
  github_username text,
  linkedin_url text,
  sources_available jsonb not null default '[]'::jsonb,
  credibility_band text
    check (credibility_band in ('high','medium','low','unknown')),
  report jsonb,
  recruiter_brief jsonb,
  candidate_explanations jsonb not null default '{}'::jsonb,
  run_count int not null default 0,
  last_run_at timestamptz,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create unique index if not exists idx_rv_application on public.resume_verifications(application_id);
create index if not exists idx_rv_candidate on public.resume_verifications(candidate_id);

create table if not exists public.verification_claims (
  id uuid primary key default gen_random_uuid(),
  verification_id uuid not null references public.resume_verifications(id) on delete cascade,
  application_id uuid not null,
  claim_text text not null,
  claim_type text not null default 'other'
    check (claim_type in ('experience','skill','education','project','certification','other')),
  verdict text not null
    check (verdict in ('VERIFIED','PARTIALLY_VERIFIED','UNVERIFIED','CONTRADICTED','UNVERIFIABLE')),
  confidence text not null default 'low' check (confidence in ('high','medium','low')),
  rationale text,
  evidence jsonb not null default '[]'::jsonb,
  explanation text,
  explanation_status text not null default 'not_requested'
    check (explanation_status in ('not_requested','requested','submitted')),
  created_at timestamptz not null default now()
);
create index if not exists idx_vc_verification on public.verification_claims(verification_id);
create index if not exists idx_vc_application on public.verification_claims(application_id);

create table if not exists public.verification_artifacts (
  id uuid primary key default gen_random_uuid(),
  verification_id uuid not null references public.resume_verifications(id) on delete cascade,
  claim_id uuid references public.verification_claims(id) on delete cascade,
  application_id uuid not null,
  source text not null,
  source_url text,
  source_label text,
  content text,
  fetched_at timestamptz,
  status text not null default 'fetched'
    check (status in ('fetched','failed','rate_limited','not_fetched')),
  created_at timestamptz not null default now()
);
create index if not exists idx_va_verification on public.verification_artifacts(verification_id);
create index if not exists idx_va_application on public.verification_artifacts(application_id);

create table if not exists public.verification_events (
  id uuid primary key default gen_random_uuid(),
  verification_id uuid not null references public.resume_verifications(id) on delete cascade,
  application_id uuid not null,
  actor_user_id uuid,
  event_type text not null,
  detail jsonb,
  created_at timestamptz not null default now()
);
create index if not exists idx_ve_verification on public.verification_events(verification_id);
create index if not exists idx_ve_application on public.verification_events(application_id);

-- RLS: reads are scoped through the existing can_access_application helper
-- (candidate owner + HR of the job). All writes happen via backend functions.
alter table public.resume_verifications enable row level security;
alter table public.verification_claims enable row level security;
alter table public.verification_artifacts enable row level security;
alter table public.verification_events enable row level security;

create policy "resume_verifications_select" on public.resume_verifications
  for select to authenticated using (can_access_application(application_id));
create policy "verification_claims_select" on public.verification_claims
  for select to authenticated using (can_access_application(application_id));
create policy "verification_artifacts_select" on public.verification_artifacts
  for select to authenticated using (can_access_application(application_id));
create policy "verification_events_select" on public.verification_events
  for select to authenticated using (can_access_application(application_id));