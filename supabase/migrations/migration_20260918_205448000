alter table public.interviews add column if not exists recording_url text;
alter table public.interview_answers add column if not exists transcript text;

insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('interview-recordings', 'interview-recordings', true, 200 * 1024 * 1024, array['video/webm','video/mp4','audio/webm','audio/mp4','audio/mp3','audio/wav','video/ogg','audio/ogg']::text[])
on conflict (id) do nothing;

do $$
begin
  if not exists (select 1 from pg_policies where schemaname = 'storage' and tablename = 'objects' and policyname = 'interview_recordings_read') then
    create policy "interview_recordings_read" on storage.objects for select to authenticated using (bucket_id = 'interview-recordings');
  end if;
  if not exists (select 1 from pg_policies where schemaname = 'storage' and tablename = 'objects' and policyname = 'interview_recordings_upload') then
    create policy "interview_recordings_upload" on storage.objects for insert to authenticated with check (bucket_id = 'interview-recordings');
  end if;
end $$;